# Copy to .env.local (gitignored) and fill in. NEVER commit real values.
# Both must be set together to switch the app off local SQLite onto Turso;
# leave them unset for zero-config local dev (scrapers/db.py falls back to db/deals.db).

# Turso database URL, e.g. libsql://your-db-name.turso.io  (from: turso db show <db> --url)
TURSO_DATABASE_URL=
# Turso auth token (from: turso db tokens create <db>). Secret — keep out of git.
TURSO_AUTH_TOKEN=

# Geocoding provider key (Phase 1). Optional: default Census/Nominatim geocoder needs no key.
GOOGLE_MAPS_API_KEY=
