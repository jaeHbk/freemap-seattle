# Copy to .env.local (gitignored) and fill in. NEVER commit real values.
# Both must be set together to switch the app off local SQLite onto Turso.
# Leave them unset for zero-config local dev.

# Turso database URL, e.g. libsql://your-db-name.turso.io  (from: turso db show <db> --url)
TURSO_DATABASE_URL=
# Turso auth token (from: turso db tokens create <db>). Secret — keep out of git.
TURSO_AUTH_TOKEN=

# Set to 1 in automation that must never fall back to local SQLite.
FREEMAP_REQUIRE_TURSO=

# Optional. The default Census geocoder needs no key.
GOOGLE_MAPS_API_KEY=
